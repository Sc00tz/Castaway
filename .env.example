# Copy to .env next to docker-compose.yml and fill in. Keep .env private: it holds your password.

# The address people use to reach Castaway, including the port.
CASTAWAY_URL=http://your-docker-host:8040

# Database password. Generate one with: openssl rand -base64 24
DB_PASSWORD=

# Where the database, downloads and backups live on the host.
DATA_DIR=/srv/castaway

# Port on the host.
CASTAWAY_PORT=8040

# Host user and group that should own downloaded files (run `id` on the host to see yours).
PUID=1000
PGID=1000

# Your timezone, e.g. America/New_York.
TZ=UTC

# Optional: private networks Castaway may fetch feeds from, e.g. 192.168.1.20,100.64.0.0/10
ALLOWED_PRIVATE_NETWORKS=
